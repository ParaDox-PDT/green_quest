{
  "rules": {
    "room_codes": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || !newData.exists())",
        ".validate": "newData.hasChildren(['roomId']) && newData.child('roomId').isString()"
      }
    },
    "rooms": {
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.child('hostId').val() == auth.uid)",
        "players": {
          "$playerId": {
            ".write": "auth != null && auth.uid == $playerId",
            ".validate": "newData.hasChildren()"
          }
        },
        "selectedFigures": {
          "$figureName": {
            ".write": "auth != null && (!data.exists() || data.val() == auth.uid || !newData.exists())",
            ".validate": "newData.val() == auth.uid"
          }
        },
        "status": {
          ".write": "auth != null && data.parent().child('hostId').val() == auth.uid",
          ".validate": "newData.val() == 'lobby' || (newData.val() == 'playing' && data.val() == 'lobby')"
        }
      }
    },
    "active_games": {
      "$roomId": {
        ".read": "auth != null && root.child('rooms/' + $roomId + '/players/' + auth.uid).exists()",
        "positions": {
          "$playerId": {
            ".write": "auth != null && auth.uid == $playerId && root.child('active_games/' + $roomId + '/currentTurn').val() == auth.uid",
            ".validate": "newData.isNumber() && newData.val() >= 0"
          }
        },
        "turnIndex": {
          ".write": "auth != null && root.child('active_games/' + $roomId + '/currentTurn').val() == auth.uid",
          ".validate": "newData.isNumber() && newData.val() == data.val() + 1"
        },
        "currentTurn": {
          ".write": "auth != null && root.child('active_games/' + $roomId + '/currentTurn').val() == auth.uid"
        }
      }
    }
  }
}
